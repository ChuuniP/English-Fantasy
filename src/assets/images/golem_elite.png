<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Background -->
  <rect width="200" height="200" fill="#c6a94e"/>
  
  <!-- Golem body -->
  <rect x="60" y="80" width="80" height="100" fill="#8b7d6b" rx="5"/>
  
  <!-- Head -->
  <circle cx="100" cy="60" r="35" fill="#a89968"/>
  
  <!-- Eyes -->
  <circle cx="85" cy="50" r="6" fill="#2c2c2c"/>
  <circle cx="115" cy="50" r="6" fill="#2c2c2c"/>
  
  <!-- Mouth -->
  <line x1="90" y1="70" x2="110" y2="70" stroke="#2c2c2c" stroke-width="2"/>
  
  <!-- Stone pattern -->
  <line x1="70" y1="100" x2="130" y2="100" stroke="#6b5d52" stroke-width="1" opacity="0.5"/>
  <line x1="70" y1="130" x2="130" y2="130" stroke="#6b5d52" stroke-width="1" opacity="0.5"/>
  
  <!-- Arms -->
  <rect x="30" y="90" width="30" height="60" fill="#8b7d6b" rx="3"/>
  <rect x="140" y="90" width="30" height="60" fill="#8b7d6b" rx="3"/>
  
  <!-- Feet -->
  <rect x="70" y="170" width="25" height="20" fill="#6b5d52"/>
  <rect x="105" y="170" width="25" height="20" fill="#6b5d52"/>
</svg>
