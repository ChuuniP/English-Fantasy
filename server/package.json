{
  "name": "english-fantasy-server",
  "version": "1.0.0",
  "description": "PostgreSQL Backend Server for English Fantasy Game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "vocab:generate": "node vocabGenerator.js",
    "vocab:floor": "node vocabGenerator.js floor",
    "vocab:elite": "node vocabGenerator.js elite",
    "vocab:boss": "node vocabGenerator.js boss",
    "db:schema-apply": "node schemaManager.js apply",
    "db:schema-check": "node schemaManager.js check",
    "db:schema-all": "node schemaManager.js all",
    "db:migrate": "node migrations.js",
    "test": "node tests.js all",
    "test:floor": "node tests.js floor",
    "test:models": "node tests.js models",
    "test:db": "node tests.js db",
    "cleanup": "node cleanup.js --force"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
